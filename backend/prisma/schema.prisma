generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("STAFF")
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryPaymentsReceived SalaryPayment[] @relation("SalaryEmployee")
  salaryPaymentsCreated  SalaryPayment[] @relation("SalaryCreator")

  activityLogs  ActivityLog[]
  shifts        StaffShift[]
  targets       StaffTarget[]
  sessions      SessionAudit[]
  otpCodes      OtpCode[]
  notifications Notification[]

  @@map("users")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  layaways     Layaway[]
  quotes       Quote[]
  debts        CustomerDebt[]
  feedback     Feedback[]
  statements   CustomerStatement[]
  onlineOrders OnlineOrder[]

  @@map("customers")
}

model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]
  transactions   SupplierTransaction[]

  @@map("suppliers")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String?  @unique
  description String?
  color       String   @default("#C9A96E")
  createdAt   DateTime @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String?  @unique
  sku               String?  @unique
  barcode           String?  @unique
  categoryId        Int?
  price             Float    @default(0)
  costPrice         Float    @default(0)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  description       String?
  images            String   @default("[]")
  tags              String   @default("[]")
  variants          String   @default("[]")
  supplierId        Int?
  gender            String?
  isFeatured        Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  stockMovements StockMovement[]

  @@map("products")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  type      String
  quantity  Int
  reason    String?
  reference String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model Order {
  id            Int      @id @default(autoincrement())
  customerId    Int?
  orderNumber   String   @unique
  status        String   @default("PENDING")
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  total         Float    @default(0)
  paymentStatus String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@map("orders")
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  amount    Float
  method    String
  reference String?
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Refund {
  id        Int      @id @default(autoincrement())
  orderId   Int?
  amount    Float
  reason    String?
  method    String?
  reference String?
  createdAt DateTime @default(now())

  @@map("refunds")
}

model Layaway {
  id          Int       @id @default(autoincrement())
  customerId  Int
  reference   String    @unique
  totalAmount Float     @default(0)
  paidAmount  Float     @default(0)
  balance     Float     @default(0)
  status      String    @default("ACTIVE")
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("layaways")
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  category    String?
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

model DiscountCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String
  value       Float
  minAmount   Float?
  maxDiscount Float?
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?
  usageCount  Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("discount_codes")
}

model SupplierTransaction {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  type        String
  amount      Float
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_transactions")
}

model StaffShift {
  id          Int       @id @default(autoincrement())
  userId      Int
  startTime   DateTime
  endTime     DateTime?
  status      String    @default("OPEN")
  openingCash Float     @default(0)
  closingCash Float?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("staff_shifts")
}

model StaffTarget {
  id        Int      @id @default(autoincrement())
  userId    Int
  target    Float    @default(0)
  period    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("staff_targets")
}

model Quote {
  id          Int       @id @default(autoincrement())
  customerId  Int?
  quoteNumber String    @unique
  status      String    @default("DRAFT")
  subtotal    Float     @default(0)
  discount    Float     @default(0)
  total       Float     @default(0)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("quotes")
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  supplierId   Int
  orderNumber  String    @unique
  status       String    @default("PENDING")
  total        Float     @default(0)
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("purchase_orders")
}

model CustomerDebt {
  id         Int       @id @default(autoincrement())
  customerId Int
  amount     Float     @default(0)
  paidAmount Float     @default(0)
  balance    Float     @default(0)
  status     String    @default("UNPAID")
  dueDate    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_debts")
}

model CashFloat {
  id        Int      @id @default(autoincrement())
  amount    Float    @default(0)
  type      String
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  @@map("cash_floats")
}

model CashBook {
  id          Int      @id @default(autoincrement())
  type        String
  amount      Float
  description String?
  reference   String?
  createdAt   DateTime @default(now())

  @@map("cash_book")
}

model DailyReconciliation {
  id             Int      @id @default(autoincrement())
  date           DateTime
  expectedAmount Float    @default(0)
  actualAmount   Float    @default(0)
  difference     Float    @default(0)
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("daily_reconciliations")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  entity      String?
  entityId    String?
  description String?
  metadata    String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Feedback {
  id         Int      @id @default(autoincrement())
  customerId Int?
  rating     Int?
  message    String?
  response   String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("feedback")
}

model CustomerStatement {
  id          Int      @id @default(autoincrement())
  customerId  Int
  type        String
  amount      Float
  description String?
  reference   String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_statements")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("otp_codes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String
  message   String
  type      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model OnlineOrder {
  id              Int      @id @default(autoincrement())
  customerId      Int?
  orderNumber     String   @unique
  status          String   @default("PENDING")
  subtotal        Float    @default(0)
  discount        Float    @default(0)
  total           Float    @default(0)
  paymentStatus   String   @default("PENDING")
  shippingAddress String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("online_orders")
}

model SessionAudit {
  id        Int      @id @default(autoincrement())
  userId    Int
  sessionId String
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("session_audits")
}

enum SalaryPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum SalaryConfirmationStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
}

enum SalaryDisputeStatus {
  NONE
  DISPUTED
  RESOLVED
}

model SalaryPayment {
  id                 Int                      @id @default(autoincrement())
  employeeId         Int
  createdById        Int
  amount             Float
  paymentDate        DateTime                 @default(now())
  paymentMethod      String
  reference          String?
  status             SalaryPaymentStatus      @default(PENDING)
  confirmationStatus SalaryConfirmationStatus @default(AWAITING_CONFIRMATION)
  disputeStatus      SalaryDisputeStatus      @default(NONE)
  confirmationDate   DateTime?
  disputeReason      String?
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  employee  User @relation("SalaryEmployee", fields: [employeeId], references: [id])
  createdBy User @relation("SalaryCreator", fields: [createdById], references: [id])

  @@map("salary_payments")
}
